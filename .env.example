# Django Configuration
DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,*.railway.app
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://*.railway.app

# Database (PostgreSQL on Railway)
USE_POSTGRES=True
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Or use DATABASE_URL format:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=media

# Email Configuration (SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@domain.com

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MAX_UPLOAD_SIZE=10485760
SIGNED_URL_TTL_SECONDS=900

# AWS S3 (if using for storage instead of Supabase)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1
